# API Base URL for development
# Use `/api` to leverage Vite's dev proxy (configured in vite.config.js)
# This avoids CORS issues by routing all /api requests through the Vite dev server
# which forwards them to the Flask backend at http://127.0.0.1:5000
VITE_API_BASE=/api

# Alternative: If you're running the backend on a different host/port, use the full URL:
# VITE_API_BASE=http://your-backend-host:5000
